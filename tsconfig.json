{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "lib": ["DOM", "ES2022", "ESNext.Disposable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "jsx": "react",
    "jsxFactory": "h",
    "types": ["@stencil/vitest/globals", "node"]
  },
  "include": ["src", ".storybook", "vitest.config.ts", "vitest-setup.ts"],
  "exclude": ["node_modules", "dist", "dist-custom-elements", "www", "storybook-static"]
}
