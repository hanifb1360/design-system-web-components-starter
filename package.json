{
  "name": "@hanifb/web-component-design-system-starter",
  "version": "0.1.0",
  "description": "Production-oriented starter architecture for framework-agnostic design systems with Stencil and Web Components.",
  "author": "Hanif Bahari",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanifb1360/design-system-web-components-starter.git"
  },
  "bugs": {
    "url": "https://github.com/hanifb1360/design-system-web-components-starter/issues"
  },
  "homepage": "https://github.com/hanifb1360/design-system-web-components-starter#readme",
  "keywords": [
    "design-system",
    "stencil",
    "web-components",
    "typescript",
    "accessibility"
  ],
  "files": [
    "dist/",
    "dist-custom-elements/",
    "loader/",
    "src/styles/",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "collection": "./dist/collection/collection-manifest.json",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./components/*": {
      "types": "./dist-custom-elements/*.d.ts",
      "import": "./dist-custom-elements/*.js"
    },
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "stencil build --dev --watch --serve",
    "build": "stencil build --prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "stencil-test --prod",
    "test:unit": "stencil-test --project spec",
    "test:browser": "stencil-test --project browser",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "npm run build && storybook build",
    "verify:package": "node scripts/verify-package.mjs",
    "build:examples": "npm run build && npm run build --prefix examples/vanilla && npm run build --prefix examples/react",
    "generate": "stencil generate",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.35.0",
    "@stencil/core": "^4.45.0",
    "@stencil/eslint-plugin": "^1.4.0",
    "@stencil/vitest": "^1.14.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@types/node": "^24.5.2",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^16.4.0",
    "lit": "^3.3.1",
    "prettier": "^3.6.2",
    "storybook": "^10.6.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^4.1.11"
  }
}
